#! /bin/bash

set -e

SMALL_YAW_RECORD_SCRIPT=/root/record-gimbal.py

record_small_yaw_start() {
    local config root
    case "${RMCS_ROBOT_TYPE:-}" in
    small_yaw_identification)
        config=/rmcs_install/share/rmcs_bringup/config/small_yaw_identification.yaml
        root=/root/rmcs_recordings/small_yaw_identification
        ;;
    small_yaw_breakaway_identification)
        config=/rmcs_install/share/rmcs_bringup/config/small_yaw_breakaway_identification.yaml
        root=/root/rmcs_recordings/small_yaw_breakaway_identification
        ;;
    gimbal_controller_identification)
        config=/rmcs_install/share/rmcs_bringup/config/gimbal_controller_identification.yaml
        root=/root/rmcs_recordings/big_yaw_identification
        ;;
    *) return 0 ;;
    esac
    if [[ -f "$SMALL_YAW_RECORD_SCRIPT" ]]; then
        python3 "$SMALL_YAW_RECORD_SCRIPT" start --remote \
            --config "$config" --root "$root"
    fi
}

record_small_yaw_stop() {
    local config root
    case "${RMCS_ROBOT_TYPE:-}" in
    small_yaw_identification)
        config=/rmcs_install/share/rmcs_bringup/config/small_yaw_identification.yaml
        root=/root/rmcs_recordings/small_yaw_identification
        ;;
    small_yaw_breakaway_identification)
        config=/rmcs_install/share/rmcs_bringup/config/small_yaw_breakaway_identification.yaml
        root=/root/rmcs_recordings/small_yaw_breakaway_identification
        ;;
    gimbal_controller_identification)
        config=/rmcs_install/share/rmcs_bringup/config/gimbal_controller_identification.yaml
        root=/root/rmcs_recordings/big_yaw_identification
        ;;
    *) return 0 ;;
    esac
    if [[ -f "$SMALL_YAW_RECORD_SCRIPT" ]]; then
        python3 "$SMALL_YAW_RECORD_SCRIPT" stop --remote \
            --config "$config" --root "$root" || true
    fi
}

start() {
    if [[ -z "$HOME" ]]; then
        export HOME=/root
    fi

    if is_running; then
        echo 'Error: RMCS daemon is still running!'
        exit 1
    fi

    source ~/env_setup.bash

    if [ -z "${RMCS_ROBOT_TYPE}" ]; then
        echo "Error: Please set robot type first (e.g. 'set-robot sentry')."
        exit 1
    fi

    screen -dmS rmcs bash -c "ros2 launch rmcs_bringup rmcs.launch.py robot:=${RMCS_ROBOT_TYPE}"

    record_small_yaw_start

    sleep 0.1
    
    if is_running; then
        echo "Successfully started RMCS daemon."
    else
        echo "Error: Failed to start RMCS daemon."
        exit 1
    fi
}

attach() {
    screen -r rmcs
}

stop() {
    source ~/env_setup.bash
    record_small_yaw_stop
    if is_running; then
        screen -S rmcs -X quit
        echo "Successfully stopped RMCS daemon."
    fi
}

is_running() {
    if ls '/run/screen/S-root' 2>/dev/null | grep -q '.*\.rmcs'; then
        return 0
    else
        return 1
    fi
}

case "$1" in
    start)
        start
        ;;
    attach)
        attach
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo 'Usage: service rmcs {start|attach|stop|restart}'
        exit 1
        ;;
esac

exit 0
