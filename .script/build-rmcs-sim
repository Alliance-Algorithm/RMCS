#!/bin/bash

source /opt/ros/jazzy/setup.bash

: "${RMCS_PATH:=/workspaces/RMCS}"

if [[ ! -d "${RMCS_PATH}/rmcs_ws" ]]; then
    echo "> ERROR: Workspace not found: ${RMCS_PATH}/rmcs_ws"
    exit 1
fi

cd "${RMCS_PATH}"/rmcs_ws || exit 1

[[ -x /opt/cmake/bin/cmake ]] &&
    export PATH="/opt/cmake/bin:$PATH"

cmake_toolchain_args=()
event_handlers_args=()

if [[ "${RMCS_USE_LLVM}" == "ON" ]]; then
    missing_tools=()
    for tool in clang clang++ llvm-ar llvm-ranlib ld.lld ninja; do
        if ! command -v "${tool}" &>/dev/null; then
            missing_tools+=("${tool}")
        fi
    done

    if ((${#missing_tools[@]} > 0)); then
        echo "> ERROR: LLVM toolchain is required when RMCS_USE_LLVM=ON."
        echo "> Missing tools: ${missing_tools[*]}"
        echo "> Install the missing tools, or set RMCS_USE_LLVM=OFF to build with GCC."
        exit 1
    fi

    echo "> Compiling With LLVM ToolChain"
    export CC=clang
    export CXX=clang++
    cmake_toolchain_args=(
        "-GNinja"
        "-DCMAKE_MESSAGE_LOG_LEVEL=ERROR"
        "-DCMAKE_EXE_LINKER_FLAGS=-fuse-ld=lld"
        "-DCMAKE_SHARED_LINKER_FLAGS=-fuse-ld=lld"
        "-DCMAKE_AR=$(command -v llvm-ar)"
        "-DCMAKE_RANLIB=$(command -v llvm-ranlib)"
    )
    event_handlers_args=(
        --event-handlers console_cohesion+
    )
fi

# The simulator uses its OWN build/install/log trees so it can coexist with the
# real-robot build (build-rmcs / install/). Launch it with launch-rmcs-sim.
colcon_args=(
    --symlink-install --merge-install
    --build-base build-sim
    --install-base install-sim
    "${event_handlers_args[@]}"
)
# The librmcs SDK is fetched with FetchContent, which cannot download here
# (proxy/SSL). Reuse the copy already fetched by a previous build-rmcs
# (build/rmcs_core/_deps/librmcs-src) so no network is needed.
librmcs_src="${RMCS_PATH}/rmcs_ws/build/rmcs_core/_deps/librmcs-src"
if [[ ! -d "${librmcs_src}" ]]; then
    echo "> ERROR: no pre-fetched librmcs at ${librmcs_src}."
    echo "> Run build-rmcs once on a machine with network first."
    exit 1
fi

cmake_args=(
    "${cmake_toolchain_args[@]}"
    # Simulation build: link the in-process MuJoCo simulation bridge.
    "-DRMCS_ENABLE_MUJOCO_SIM=ON"
    "-DFETCHCONTENT_SOURCE_DIR_LIBRMCS=${librmcs_src}"
)

CLICOLOR_FORCE=1 NINJA_STATUS="" \
    colcon --log-base log-sim \
    build "${colcon_args[@]}" "$@" --cmake-args "${cmake_args[@]}"
