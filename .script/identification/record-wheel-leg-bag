#!/usr/bin/env bash
# Run inside the RMCS development container. Keep bag I/O out of the 1 kHz executor.
set -euo pipefail

if [[ $# -ne 2 || ! -f "$1" || ! -d "$2" ]]; then
    printf 'Usage: %s <run-parameters.yaml> <existing-output-directory>\n' "$0" >&2
    exit 2
fi

profile="$(realpath "$1")"
output_root="$(realpath "$2")"
source /opt/ros/jazzy/setup.bash
source /workspaces/RMCS/rmcs_ws/install/setup.bash
python3 /workspaces/RMCS/.script/identification/check_wheel_leg_profile.py "$profile"

side="$(python3 -c 'import sys,yaml
p=yaml.safe_load(open(sys.argv[1],encoding="utf-8"))
side=p["wheel_leg_identification_recorder"]["ros__parameters"]["side"]
if side not in ("left","right"): raise SystemExit("recorder side must be left or right")
print(side)' "$profile")"
run="$output_root/wheel-leg-$side-$(date -u +%Y%m%dT%H%M%SZ)"
if [[ -e "$run" ]]; then
    printf 'Run directory already exists: %s\n' "$run" >&2
    exit 1
fi
mkdir "$run"
cp -- "$profile" "$run/profile.yaml"
sha256sum "$run/profile.yaml" > "$run/profile.sha256"
git -C /workspaces/RMCS rev-parse HEAD > "$run/rmcs-head.txt"

printf 'Recording %s to %s; start the controller only after ros2 bag reports ready.\n' \
    /wheel_leg/identification/sample "$run/bag"
ros2 bag record -s mcap -o "$run/bag" /wheel_leg/identification/sample
