#!/bin/python3

import socket
import selectors
import os
import subprocess
import sys

from colorama import Fore, Style


RMCS_PATH = os.getenv("RMCS_PATH") or "/workspaces/RMCS"
SRC_DIR = os.path.join(RMCS_PATH, "rmcs_ws", "install")
DST_DIR = "ssh://remote//rmcs_install"
SOCKET_PATH = "/tmp/sync-remote"

SYNC_FLAG = b"Nothing to do:"
COLORED_SYNC_FLAG = (
    f"{Fore.LIGHTGREEN_EX}{Style.BRIGHT}Nothing to do{Style.RESET_ALL}:".encode("ascii")
)


def create_process():
    command = [
        "unison",
        "-ignorearchives",
        "-auto",
        "-batch",
        "-repeat",
        "watch",
        "-times",
        SRC_DIR,
        DST_DIR,
        "-force",
        SRC_DIR,
        "-follow",
        "Name *",
        "-sshargs",
        "-o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=5 -o ServerAliveCountMax=3",
    ]
    return subprocess.Popen(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )


def create_server():
    if os.path.exists(SOCKET_PATH):
        os.remove(SOCKET_PATH)

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(SOCKET_PATH)
    server.listen()
    server.setblocking(False)

    return server


def finish_connection(conn: socket):
    try:
        conn.sendall(b"f")
    except OSError:
        pass
    finally:
        conn.close()


def main():
    process = None
    server = None
    clients = []
    ready = False
    pending = b""

    try:
        server = create_server()
        process = create_process()
        with selectors.DefaultSelector() as selector, process.stdout as output:
            selector.register(output, selectors.EVENT_READ)
            selector.register(server, selectors.EVENT_READ)
            while True:
                events = selector.select()
                # Consume Unison's output before answering concurrent waiters.
                events.sort(key=lambda event: event[0].fileobj is server)
                for key, _ in events:
                    if key.fileobj is server:
                        conn, _ = server.accept()
                        if ready and process.poll() is None:
                            finish_connection(conn)
                        else:
                            clients.append(conn)
                        continue

                    chunk = os.read(output.fileno(), 4096)
                    if not chunk:
                        sys.stdout.buffer.write(pending)
                        sys.stdout.buffer.flush()
                        status = process.wait()
                        return status if status >= 0 else 128 - status

                    *lines, pending = (pending + chunk).split(b"\n")
                    for line in lines:
                        if line.strip():
                            ready = line.startswith(SYNC_FLAG)
                        if line.startswith(SYNC_FLAG):
                            line = COLORED_SYNC_FLAG + line[len(SYNC_FLAG) :]
                        sys.stdout.buffer.write(line + b"\n")
                    sys.stdout.buffer.flush()
                    if ready and process.poll() is None:
                        for conn in clients:
                            finish_connection(conn)
                        clients.clear()
    except OSError as error:
        print(f"sync-remote: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    finally:
        for conn in clients:
            conn.close()
        if server is not None:
            server.close()
            os.unlink(SOCKET_PATH)
        if process is not None and process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


if __name__ == "__main__":
    sys.exit(main())
