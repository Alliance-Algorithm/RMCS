             '|运行|时长/s|脉冲数|结束状态|拟合资格|', '|---|---:|---:|---|---|']
    for run in report['runs']:
        lines.append('|%d|%.3f|%d|%s|%s|' % (run['run'], run['duration_s'], run['pulse_count'], run['terminal_state'], '满足质量门槛' if run['fit_eligible'] else '排除'))
        if 'big_yaw_peak_to_peak_rad' in run:
            lines.append('运行 %d 大 yaw 全段峰峰值 %.6g rad；拟合候选窗口 %d，保留 %d，因附近大 yaw 运动剔除 %d（检查范围前后各 %.3g s）。' %
                         (run['run'], run['big_yaw_peak_to_peak_rad'] or 0.0,
                          run.get('fit_candidate_windows', 0), run.get('fit_windows_retained', 0),
                          run.get('big_yaw_motion_windows_excluded', 0),
                          run.get('big_yaw_local_window_padding_s', BIG_YAW_WINDOW_PADDING_S)))
        if run['terminal_reasons_observed']:
            lines.extend(['', '运行 %d 结束后观测到的原因：%s。' % (run['run'], ', '.join(run['terminal_reasons_observed']))])
        if run['fit_exclusions']:
            lines.extend(['', '运行 %d 排除原因：%s。' % (run['run'], '; '.join(run['fit_exclusions']))])
    fit = report['fit']
    lines.extend(['', '拟合状态：`' + fit['status'] + '`。', '',
                  '正向/反向有效积分窗口：%d / %d。' % (fit['positive_windows'], fit['negative_windows'])])
    lines.append('拟合只检查每个候选窗口前后各 %.3f s 的大 yaw 角度峰峰值（门槛 %.4g rad）；局部运动剔除 %d 个窗口，缺数据无法判断 %d 个窗口。' %
                 (fit.get('big_yaw_window_padding_s', BIG_YAW_WINDOW_PADDING_S),
                  fit.get('big_yaw_window_threshold_rad', FIXED_BASE_EXCURSION_RAD),
                  fit.get('big_yaw_motion_windows_excluded', 0),
                  fit.get('big_yaw_window_checks_missing', 0)))
    lines.extend(['', '主力矩输入：电机实际电流折算估值；软件下发力矩只作对照。',
                  '有效电流-运动时间偏移：%.1f ms（搜索范围 ±%.0f ms；正值表示将电流窗口向更早时刻移动）。' %
                  (fit.get('current_motion_offset_ms', 0.0), MAX_CURRENT_MOTION_SHIFT_S * 1000.0)])
    for reason in fit['reasons']:
        lines.extend(['', reason])
    if fit['models']:
        lines.extend(['', '设计矩阵秩：%d；列归一化条件数：%.4g。' % (fit['rank'], fit['column_scaled_condition_number']), '',
                      '|力矩输入|J/(kg·m²)|b/(Nm·s/rad)|Fc/Nm|bias/Nm|残差 RMSE/Nm|', '|---|---:|---:|---:|---:|---:|'])
        for name, model in fit['models'].items():
            lines.append('|%s|%.6g|%.6g|%.6g|%.6g|%.6g|' % (TORQUE_INPUT_LABELS.get(name, name), model['J_kg_m2'], model['b_nm_s_rad'], model['Fc_nm'], model['bias_nm'], model['rmse_average_torque_nm']))
            validation = model['repeat_run_validation']
            loo = validation['leave_one_run_out']
            lines.extend(['', '**%s：** 整轮留出验证：`%s`，独立轮数 %d。' %
                          (TORQUE_INPUT_LABELS.get(name, name), loo['status'], validation['independent_runs'])])
            if 'pooled_metrics' in loo:
                metrics = loo['pooled_metrics']
                lines.append('留出轮次合并误差：RMSE %.6g Nm，MAE %.6g Nm，R² %s。' %
                             (metrics['rmse_nm'], metrics['mae_nm'],
                              'n/a' if metrics['r_squared'] is None else '%.6g' % metrics['r_squared']))
            elif loo.get('reason'):
                lines.append(loo['reason'])
            bootstrap = validation['run_cluster_bootstrap_95_percent_interval']
            if bootstrap['status'] == 'estimated':
                lines.append('按整轮重采样得到的 95%% 参数区间：')
                lines.append('')
                lines.append('|参数|2.5 百分位|97.5 百分位|')
                lines.append('|---|---:|---:|')
                for parameter, interval in bootstrap['parameters'].items():
                    lines.append('|%s|%.6g|%.6g|' %
                                 (parameter, interval['lower_2_5_percent'], interval['upper_97_5_percent']))
            elif bootstrap.get('reason'):
                lines.append(bootstrap['reason'])
            else:
                lines.append('整轮 bootstrap 有效重采样不足：%d / %d。' %
                             (bootstrap.get('successful_replicates', 0), bootstrap['replicates_requested']))
            phase_diagnostics = model.get('phase_diagnostics', {})
            if phase_diagnostics:
                lines.extend(['', '按激励阶段检查拟合残差（训练数据诊断）：', '',
                              '|阶段|窗口数|轮数|RMSE/Nm|MAE/Nm|平均有符号残差/Nm|',
                              '|---|---:|---:|---:|---:|---:|'])
                for phase, metrics in phase_diagnostics.items():
                    lines.append('|%s|%d|%d|%.6g|%.6g|%.6g|' %
                                 (phase, metrics['windows'], metrics['runs'], metrics['rmse_nm'],
                                  metrics['mae_nm'], metrics['mean_signed_residual_nm']))
        directional = fit.get('directional_models', {})
        if directional:
            lines.extend(['', '方向不对称摩擦模型（诊断，不自动用于控制）：', '',
                          '|力矩输入|J|b+|b-|Fc+|Fc-|RMSE/Nm|',
                          '|---|---:|---:|---:|---:|---:|---:|'])
            for name, model in directional.items():
                lines.append('|%s|%.6g|%.6g|%.6g|%.6g|%.6g|%.6g|' %
                             (name, model['J_kg_m2'], model['b_positive_nm_s_rad'],
                              model['b_negative_nm_s_rad'], model['Fc_positive_nm'],
                              model['Fc_negative_nm'], model['rmse_average_torque_nm']))
                validation = model['repeat_run_validation']['leave_one_run_out']
                lines.append('方向模型 `%s` 整轮留出：`%s`，偏移 %.1f ms%s' %
                             (name, validation['status'], model.get('current_motion_offset_ms', 0.0),
                              ('，RMSE %.6g Nm，R² %s' %
                               (validation['pooled_metrics']['rmse_nm'],
                                'n/a' if validation['pooled_metrics']['r_squared'] is None else
                                '%.6g' % validation['pooled_metrics']['r_squared']))
                              if 'pooled_metrics' in validation else ''))
        elif fit.get('directional_model_reason'):
            lines.extend(['', '方向不对称模型未拟合：' + fit['directional_model_reason']])
    lines.extend(['', '逐阶段与逐脉冲、正弦、恒力矩和线性扫力矩的量化命令、位移、速度、joint2 姿态、大 yaw 运动详见 `analysis.json`、`pulses.csv`、`sine_segments.csv` 和 `excitation_segments.csv`；重建样本见 `can_samples.csv`。', '',
                  '**电机反馈力矩由电流折算，不是真实力矩传感器测量。拟合描述这组记录中的表观响应；是否通过整轮留出验证见上表。**', ''])
    lines.extend('- ' + limitation for limitation in LIMITATIONS)
    return '\n'.join(lines) + '\n'


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog='Stop the recorder cleanly first. Source /opt/ros/jazzy/setup.bash and /rmcs_install/setup.bash before running.')
    parser.add_argument('--bag', required=True, type=Path, help='Completed bag DIRECTORY containing finalized metadata.yaml')
    parser.add_argument('--output', type=Path, help='New analysis directory outside the bag (default: sibling small_yaw_analysis_<UTC timestamp>)')
    parser.add_argument('--command-sign', type=float, choices=(-1.0, 1.0),
                        help='Override polarity when analyzing recordings made before polarity was saved in YAML')
    args = parser.parse_args()
    bag = args.bag.expanduser().resolve()
    output = (args.output.expanduser().resolve() if args.output else
              bag.parent / ('small_yaw_analysis_' + datetime.now(timezone.utc).strftime('%Y%m%d_%H%M%S_%f')))
    if output == bag or output.is_relative_to(bag) or output.exists():
        parser.error('--output must be a new directory outside the original bag')
    metadata, recorder, snapshot, limits = validate_bag(bag)
    if args.command_sign is not None:
        limits['command_sign'] = args.command_sign
    before = file_signature(bag)
    series, types, atomic_samples = read_bag(bag, metadata)
    period = series['state'].period() or 0.005
    samples, can_metadata = reconstruct_can(series, period, atomic_samples)
    clock_jitter, clock_jitter_estimation = estimate_clock_jitter(
        can_metadata['clock_segments'], period)
    # Protect the +/-25 ms quadratic encoder fit as well as state/bag-clock skew.
    margin = max(0.02, 3 * period) + clock_jitter
    bag_end = int(metadata['duration']['nanoseconds']) * 1e-9
    events = transitions(series['state'], bag_end)
    runs = analyze_runs(events, series, samples, limits, margin)
    fit, windows = fit_models(runs, series, samples, margin)
    if file_signature(bag) != before:
        raise RuntimeError('Bag files changed during analysis; no analysis output written. Stop the recorder first')
    report = {
        'format_version': 2, 'bag': str(bag), 'analysis_time_utc': datetime.now(timezone.utc).isoformat(),
        'script_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        'input_file_signatures_size_mtime_ns': before, 'recorded_topics': len(types),
        'analyzed_topics': {name: {'topic': TOPICS[name], 'messages': len(data.t), 'median_period_s': data.period()} for name, data in series.items()},
        'atomic_can_samples_recorded': len(atomic_samples),
        'saved_config': snapshot, 'quality_limits': limits,
        'limits_source': 'verified saved recording config' if snapshot else 'built-in small-yaw profile defaults; configuration snapshot unavailable',
        'boundary_guard_s': margin, 'clock_jitter_estimation': clock_jitter_estimation,
        'torque_command_quantum_nm': QUANTUM_NM,
        'can_reconstruction': can_metadata, 'state_transitions': events,
        'runs': runs, 'fit': fit, 'limitations': LIMITATIONS,
    }
    report = clean_json(report)
    output.mkdir(parents=True, exist_ok=False)
    (output / 'analysis.json').write_text(json.dumps(report, ensure_ascii=False, indent=2, allow_nan=False) + '\n')
    write_csv(output / 'can_samples.csv', samples)
    write_csv(output / 'fit_windows.csv', [{**window, 'row': json.dumps(window['row'])} for window in windows])
    pulses = []
    sine_segments = []
    excitation_segments = []
    for run in runs:
        for phase in run['phases']:
            if phase['state'] == 'pulse':
                pulses.append({'run': run['run'], 'pulse': phase['pulse_index'], 'start_s': phase['start_s'],
                               'duration_s': phase['duration_s'], 'unique_can_samples': phase['can_samples'],
                               'expected_command_nm': phase.get('expected_command_nm'),
                               'waveform_matches_expected': phase.get('waveform_matches_expected'),
                               'quantized_command_nm': json.dumps(phase['actual_quantized_command_nm']),
                               'angle_delta_rad': phase['angle_rad'].get('delta'),
                               'velocity_min_rad_s': phase['encoder_velocity_rad_s'].get('min'),
                               'velocity_max_rad_s': phase['encoder_velocity_rad_s'].get('max'),
                               'current_estimate_torque_min_nm': phase['motor_torque'].get('min'),
                               'current_estimate_torque_max_nm': phase['motor_torque'].get('max'),
                               'joint2_error_max_abs_rad': phase['joint2_error'].get('max_abs'),
                               'joint2_velocity_max_abs_rad_s': phase['joint2_velocity'].get('max_abs'),
                               'big_yaw_angle_excursion_rad': phase['big_yaw_angle'].get('peak_to_peak'),
                               'big_yaw_velocity_max_abs_rad_s': phase['big_yaw_velocity'].get('max_abs'),
                               'big_yaw_torque_min_nm': phase['big_yaw_torque'].get('min'),
                               'big_yaw_torque_max_nm': phase['big_yaw_torque'].get('max')})
            elif phase['state'] == 'sine':
                sine_segments.append({
                    'run': run['run'], 'start_s': phase['start_s'],
                    'duration_s': phase['duration_s'],
                    'frequency_hz': phase.get('sine_frequency_hz'),
                    'frequency_end_hz': phase.get('sine_frequency_end_hz'),
                    'amplitude_nm': phase.get('sine_amplitude_nm'),
                    'actual_quantized_commands_nm': json.dumps(phase['actual_quantized_command_nm']),
                    'angle_delta_rad': phase['angle_rad'].get('delta'),
                    'angle_peak_to_peak_rad': phase['angle_rad'].get('peak_to_peak'),
                    'encoder_velocity_max_abs_rad_s': phase['encoder_velocity_rad_s'].get('max_abs'),
                    'current_estimate_torque_min_nm': phase['motor_torque'].get('min'),
                    'current_estimate_torque_max_nm': phase['motor_torque'].get('max'),
                    'joint2_error_max_abs_rad': phase['joint2_error'].get('max_abs'),
                    'joint2_velocity_max_abs_rad_s': phase['joint2_velocity'].get('max_abs'),
                    'big_yaw_angle_excursion_rad': phase['big_yaw_angle'].get('peak_to_peak'),
                })
            elif phase['state'] in {'constant_positive', 'constant_negative',
                                    'ramp_up', 'ramp_down',
                                    'ramp_reverse_up', 'ramp_reverse_down'}:
                excitation_segments.append({
                    'run': run['run'], 'state': phase['state'],
                    'start_s': phase['start_s'], 'duration_s': phase['duration_s'],
                    'expected_start_nm': phase.get('constant_torque_nm', phase.get('ramp_start_nm')),
                    'expected_end_nm': phase.get('constant_torque_nm', phase.get('ramp_end_nm')),
                    'actual_quantized_commands_nm': json.dumps(phase['actual_quantized_command_nm']),
                    'waveform_matches_expected': phase.get('waveform_matches_expected'),
                    'angle_delta_rad': phase['angle_rad'].get('delta'),
                    'angle_peak_to_peak_rad': phase['angle_rad'].get('peak_to_peak'),
                    'encoder_velocity_max_abs_rad_s': phase['encoder_velocity_rad_s'].get('max_abs'),
                    'current_estimate_torque_min_nm': phase['motor_torque'].get('min'),
                    'current_estimate_torque_max_nm': phase['motor_torque'].get('max'),
                    'joint2_error_max_abs_rad': phase['joint2_error'].get('max_abs'),
                    'joint2_velocity_max_abs_rad_s': phase['joint2_velocity'].get('max_abs'),
                    'big_yaw_angle_excursion_rad': phase['big_yaw_angle'].get('peak_to_peak'),
                })
    write_csv(output / 'pulses.csv', pulses)
    write_csv(output / 'sine_segments.csv', sine_segments)
    write_csv(output / 'excitation_segments.csv', excitation_segments)
    (output / 'report.md').write_text(render_report(report))
    print(json.dumps({'output': str(output), 'runs': len(runs), 'fit_status': fit['status'],
                      'fit_reasons': fit['reasons'], 'raw_bag_unchanged': True}, ensure_ascii=False, indent=2))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError, ValueError, KeyError, ImportError) as error:
        print('analyze-small-yaw-identification: ' + str(error), file=sys.stderr)
        sys.exit(1)
